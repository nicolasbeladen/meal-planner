<% if ingredients.present? %>
  <div class="card ingredients-summary mb-4">
    <div class="card-body d-flex align-items-center">
      <span>
        <i class="fa-solid fa-cart-shopping"></i>
        <strong><%= ingredients.size %> ingredients</strong> from these recipes
      </span>
      <a class="btn btn-link p-0" data-bs-toggle="collapse" href="#ingredients-list"
         role="button" aria-expanded="false" aria-controls="ingredients-list">
        View <i class="fa-solid fa-chevron-down"></i>
      </a>
    </div>
    <div class="collapse" id="ingredients-list">
      <div class="card-body border-top pt-3">
        <ul class="ingredients-list list-unstyled mb-0">
          <% ingredients.each do |ingredient| %>
            <li>
              <%= ingredient[:name].capitalize %>
              <% if ingredient[:unit].present? %>
                x <%= number_with_precision(ingredient[:quantity], precision: 1, strip_insignificant_zeros: true) %> <%= ingredient[:unit] %>
              <% else %>
                x <%= ingredient[:quantity].to_i %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
<% end %>
