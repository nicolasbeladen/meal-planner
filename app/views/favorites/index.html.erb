<div class="gradient-hero">
  <%= render "shared/page_header",
        title: "My favorite recipes",
        subtitle: "Find all your saved recipes in one place." %>
 <div class="mb-4">
    <%= link_to "← Back to menus", menus_path, class: "btn btn-outline-light btn-sm" %>
  </div>
  <div class="mt-5">
    <% if @recipes.any? %>
      <%= render "recipes/recipes",
      recipes: @recipes,
      locked: false,
      favorites_page: true,
      favorites: @favorites %>
    <% else %>
      <p class="recipes-empty">You don't have any favorite recipes yet.</p>
    <% end %>
  </div>
</div>
